# --- Site domain ---------------------------------------------------------------
# Public URL of this marketing site (https, no trailing slash). Used for canonical,
# Open Graph, JSON-LD, robots.txt and sitemap.xml. Nothing else references the domain.
# Production:              https://support-toolkit.nl
# Previous (now redirects): https://toolkit.rubenmuller.nl
VITE_SITE_URL=https://support-toolkit.nl

# --- External integrations (all optional) ---------------------------------------
# Sign-in link for the existing Support Toolkit application. Empty = button hidden.
VITE_APP_URL=
# Contact address for the "Request access" button. Empty = button hidden.
VITE_CONTACT_EMAIL=
# Privacy-friendly analytics script (e.g. Plausible/Umami). The tracked domain is taken
# from the browser at runtime, so a domain migration needs no change here.
VITE_ANALYTICS_SRC=
# Set to "true" to emit "Disallow: /" in robots.txt and a noindex meta tag (useful for staging).
VITE_NOINDEX=false
