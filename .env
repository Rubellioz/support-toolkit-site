# Build-time defaults for every environment. Override locally in .env.local or in CI.
# See .env.example for documentation of every variable.

# Public URL of this website (https, no trailing slash) — the ONLY place the site domain is set.
VITE_SITE_URL=https://toolkit.rubenmuller.nl

# Existing Support Toolkit application (sign-in button). Empty hides the button.
VITE_APP_URL=https://support-toolkit.rubenmuller.nl
